{
	"name": "@inzero/ts-ut",
	"version": "0.0.1",
	"description": "TypeScript Utility Types",
	"keywords": [
		"typescript",
		"utility",
		"types"
	],
	"license": "MIT",
	"author": "InZero",
	"exports": {
		".": "./dist/index.d.ts",
		"./string": "./dist/string/index.d.ts",
		"./number": "./dist/number/index.d.ts",
		"./func": "./dist/func/index.d.ts",
		"./other": "./dist/other/index.d.ts",
		"./list": "./dist/list/index.d.ts",
		"./tuple": "./dist/tuple/index.d.ts",
		"./dict": "./dist/dict/index.d.ts"
	},
	"main": "dist/index.d.ts",
	"files": [
		"dist",
		"package.json",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"prettier": "^3.9.10",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.11.2",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.11.2",
			"onFail": "download"
		}
	}
}
