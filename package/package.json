{
	"name": "ts-ut",
	"version": "0.0.1",
	"description": "TypeScript Utility Types",
	"keywords": [
		"typescript",
		"utility",
		"types"
	],
	"license": "MIT",
	"author": "InZero",
	"main": "dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"prettier": "^3.9.10",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.11.2",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.11.2",
			"onFail": "download"
		}
	}
}
